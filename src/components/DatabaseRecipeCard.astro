---
import type { RecipePost } from "@/types/post";
import { SITE } from "@/config";

type Props = {
  post: RecipePost;
  eager?: boolean;
};

const { post, eager = false } = Astro.props;
const image = post.featuredImage ?? `/${SITE.ogImage}`;
---

<article
  class="group overflow-hidden rounded-lg border border-border bg-background shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <a href={post.url} class="block">
    <div class="aspect-[4/3] overflow-hidden bg-muted">
      <img
        src={image}
        alt=""
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
    </div>
    <div class="space-y-3 p-4">
      <div class="flex flex-wrap gap-2 text-xs font-medium text-accent">
        <span>{post.category}</span>
      </div>
      <h3 class="text-lg font-semibold leading-snug">{post.title}</h3>
      <p class="line-clamp-3 text-sm text-foreground/75">{post.excerpt}</p>
    </div>
  </a>
  <a
    href={`/categorie/${post.categorySlug}/`}
    class="sr-only"
  >
    Voir la categorie {post.category}
  </a>
</article>
