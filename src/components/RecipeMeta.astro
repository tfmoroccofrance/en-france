---
type Props = {
  prepTime?: string;
  cookTime?: string;
  totalTime?: string;
  recipeYield?: string;
};

const items = [
  ["Preparation", Astro.props.prepTime],
  ["Cuisson", Astro.props.cookTime],
  ["Total", Astro.props.totalTime],
  ["Portions", Astro.props.recipeYield],
].filter(([, value]) => value);
---

{
  items.length > 0 && (
    <dl class="grid grid-cols-2 gap-3 rounded-lg border border-border bg-muted/30 p-4 sm:grid-cols-4">
      {items.map(([label, value]) => (
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-foreground/60">
            {label}
          </dt>
          <dd class="mt-1 font-semibold">{value}</dd>
        </div>
      ))}
    </dl>
  )
}
