---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="my-8 flex flex-col items-center gap-3">
      <span class="text-xs font-semibold uppercase tracking-widest text-foreground/40">
        Partager cette recette
      </span>
      <div class="flex items-center justify-center gap-1">
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href + URL}`}
            class="flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background transition hover:border-accent hover:text-accent"
            title={social.linkTitle}
          >
            <social.icon class="size-3.5 fill-transparent stroke-current stroke-2" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
