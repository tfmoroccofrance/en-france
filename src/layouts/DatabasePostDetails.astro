---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import EzoicAd from "@/components/EzoicAd.astro";
import DatabaseRecipeCard from "@/components/DatabaseRecipeCard.astro";
import type { RecipePost } from "@/types/post";
import {
  createSupabaseBreadcrumbSchema,
  createSupabaseRecipeSchema,
  getPostImageUrl,
} from "@/utils/supabaseSchema";
import { SITE } from "@/config";

type Props = {
  post: RecipePost;
  relatedPosts?: RecipePost[];
};

const { post, relatedPosts = [] } = Astro.props;
const canonicalURL = new URL(post.url, Astro.url).href;
const image = getPostImageUrl(post, Astro.url);
const structuredData = [
  createSupabaseRecipeSchema(post, Astro.url),
  createSupabaseBreadcrumbSchema(post, Astro.url),
];

function decodeHtmlEntities(str: string): string {
  return str
    .replace(/&#8211;/g, "\u2013")
    .replace(/&#8212;/g, "\u2014")
    .replace(/&#8216;/g, "\u2018")
    .replace(/&#8217;/g, "\u2019")
    .replace(/&#8220;/g, "\u201C")
    .replace(/&#8221;/g, "\u201D")
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&nbsp;/g, " ")
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)));
}

const cleanTitle = decodeHtmlEntities(post.title);
const cleanMetaTitle = decodeHtmlEntities(post.metaTitle);
---

<Layout
  title={`${cleanMetaTitle} | ${SITE.title}`}
  description={post.metaDescription}
  canonicalURL={canonicalURL}
  ogImage={image}
  pubDatetime={post.publishedAt}
  modDatetime={post.publishedAt}
  structuredData={structuredData}
  scrollSmooth
>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class="app-layout pb-12"
    data-pagefind-body
  >

    <!-- Breadcrumb -->
    <nav aria-label="Fil d'Ariane" class="mb-4 text-sm text-foreground/70">
      <a href="/" class="hover:text-accent">Accueil</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a href={`/categorie/${post.categorySlug}/`} class="hover:text-accent">
        {post.category}
      </a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="line-clamp-1">{cleanTitle}</span>
    </nav>

    <article class="mx-auto max-w-3xl w-full">
      <header class="space-y-3">

        <span class="inline-flex rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent uppercase tracking-wide">
          {post.category}
        </span>

        <h1 class="max-w-4xl text-lg font-bold leading-snug text-foreground sm:text-xl lg:text-2xl">
          {cleanTitle}
        </h1>

        {post.excerpt && (
          <p class="max-w-3xl text-sm text-foreground/70 sm:text-base leading-relaxed">
            {post.excerpt}
          </p>
        )}

        <p class="text-xs text-foreground/55 sm:text-sm">
          Par {SITE.author} · {post.publishedAt.toLocaleDateString("fr-FR", {
            day: "2-digit",
            month: "long",
            year: "numeric",
          })}
        </p>

      </header>

      <!-- Ezoic | 102 | under_page_title -->
      <div class="my-5">
        <EzoicAd id={102} />
      </div>

      <!-- الصورة الرئيسية -->
      {post.featuredImage && (
        <img
          src={post.featuredImage}
          alt={cleanTitle}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          sizes="(min-width: 900px) 768px, 100vw"
          class="mt-4 mx-auto block w-full max-w-3xl aspect-[16/9] rounded-xl object-cover shadow-md"
        />
      )}

      <!-- المحتوى -->
      {post.content ? (
        <div
          id="post-content"
          class="app-prose mt-8 mx-auto w-full max-w-3xl prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
          set:html={post.content}
        />
      ) : (
        <div class="mt-8 rounded-lg border border-border bg-muted/30 p-5 text-sm">
          Cette recette sera disponible prochainement.
        </div>
      )}

      <!-- Ezoic | 109 | under_first_paragraph -->
      <div class="my-6 max-w-3xl">
        <EzoicAd id={109} />
      </div>

    </article>

    <ShareLinks />

    <!-- Recettes liées -->
    {relatedPosts.length > 0 && (
      <section class="mt-12 border-t border-border pt-10" data-pagefind-ignore>
        <div class="mb-6 flex items-center gap-3">
          <span class="inline-block h-4 w-0.5 rounded-full bg-accent"></span>
          <h2 class="text-sm font-bold uppercase tracking-widest text-foreground/60">Recettes liées</h2>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          {relatedPosts.slice(0, 3).map(relatedPost => (
            <DatabaseRecipeCard post={relatedPost} />
          ))}
        </div>
      </section>
    )}

    <!-- Ezoic | 103 | bottom_of_page -->
    <div class="my-8">
      <EzoicAd id={103} />
    </div>

    <BackToTopButton />
  </main>
  <Footer />
</Layout>

<script is:inline>
  function hideFirstContentImage() {
    const content = document.getElementById("post-content");
    if (!content) return;
    const firstImg = content.querySelector("img");
    if (!firstImg) return;
    const parent = firstImg.parentElement;
    if (parent && parent.tagName === "P" && parent.children.length === 1) {
      parent.style.display = "none";
    } else {
      firstImg.style.display = "none";
    }
  }
  hideFirstContentImage();
  document.addEventListener("astro:after-swap", hideFirstContentImage);
</script>