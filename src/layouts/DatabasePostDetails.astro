---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import AdSlot from "@/components/AdSlot.astro";
import DatabaseRecipeCard from "@/components/DatabaseRecipeCard.astro";
import type { RecipePost } from "@/types/post";
import {
  createSupabaseBreadcrumbSchema,
  createSupabaseRecipeSchema,
  getPostImageUrl,
} from "@/utils/supabaseSchema";
import { SITE } from "@/config";
type Props = {
  post: RecipePost;
  relatedPosts?: RecipePost[];
};
const { post, relatedPosts = [] } = Astro.props;
const canonicalURL = new URL(post.url, Astro.url).href;
const image = getPostImageUrl(post, Astro.url);
const structuredData = [
  createSupabaseRecipeSchema(post, Astro.url),
  createSupabaseBreadcrumbSchema(post, Astro.url),
];
---
<Layout
  title={`${post.metaTitle} | ${SITE.title}`}
  description={post.metaDescription}
  canonicalURL={canonicalURL}
  ogImage={image}
  pubDatetime={post.publishedAt}
  modDatetime={post.publishedAt}
  structuredData={structuredData}
  scrollSmooth
>
  <Header />
  <BackButton />
  <main
    id="main-content"
    class="app-layout pb-12"
    data-pagefind-body
  >
    <nav aria-label="Fil d'Ariane" class="mb-4 text-sm text-foreground/70">
      <a href="/" class="hover:text-accent">Accueil</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <a
        href={`/categorie/${post.categorySlug}/`}
        class="hover:text-accent"
      >
        {post.category}
      </a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span>{post.title}</span>
    </nav>
    <article>
      <header class="space-y-5">
        <span class="inline-flex rounded-full bg-accent/10 px-3 py-1 text-sm font-medium text-accent">
          {post.category}
        </span>
        <h1 class="max-w-4xl text-3xl font-bold leading-tight text-accent sm:text-5xl">
          {post.title}
        </h1>
        <p class="max-w-3xl text-lg text-foreground/75">{post.excerpt}</p>
        <p class="text-sm text-foreground/70">
          Par {SITE.author} · {post.publishedAt.toLocaleDateString("fr-FR", {
            day: "2-digit",
            month: "long",
            year: "numeric",
          })}
        </p>
      </header>
      {post.featuredImage && (
        <img
          src={post.featuredImage}
          alt=""
          loading="eager"
          decoding="async"
          fetchpriority="high"
          sizes="(min-width: 900px) 768px, 100vw"
          class="mt-8 aspect-[16/10] w-full rounded-lg object-cover"
        />
      )}
      <AdSlot label="Emplacement publicitaire" />
      {
        post.content ? (
          <div
            id="post-content"
            class="app-prose mt-8 w-full max-w-3xl prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
            set:html={post.content}
          />
        ) : (
          <div class="mt-8 rounded-lg border border-border bg-muted/30 p-5">
            Cette recette sera disponible prochainement.
          </div>
        )
      }
    </article>
    <ShareLinks />
    {
      relatedPosts.length > 0 && (
        <section class="mt-10" data-pagefind-ignore>
          <h2 class="text-2xl font-semibold">Recettes liees</h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map(relatedPost => (
              <DatabaseRecipeCard post={relatedPost} />
            ))}
          </div>
        </section>
      )
    }
    <BackToTopButton />
  </main>
  <Footer />
</Layout>

<script is:inline>
  function hideFirstContentImage() {
    const content = document.getElementById("post-content");
    if (!content) return;
    const firstImg = content.querySelector("img");
    if (!firstImg) return;
    const parent = firstImg.parentElement;
    if (parent && parent.tagName === "P" && parent.children.length === 1) {
      parent.style.display = "none";
    } else {
      firstImg.style.display = "none";
    }
  }
  hideFirstContentImage();
  document.addEventListener("astro:after-swap", hideFirstContentImage);
</script>
