---
import type { RecipePost } from "@/types/post";
import { SITE } from "@/config";

type Props = {
  post: RecipePost;
  eager?: boolean;
};

const { post, eager = false } = Astro.props;
const image = post.featuredImage ?? `/${SITE.ogImage}`;
---

<article
  class="group overflow-hidden rounded-lg border border-border bg-background shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <a href={post.url} class="block">
    <div class="h-44 overflow-hidden bg-muted sm:h-48">
      <img
        src={image}
        alt=""
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
      />
    </div>
    <div class="space-y-2 p-4">
      <div class="flex flex-wrap gap-2 text-xs font-medium text-accent">
        <span>{post.category}</span>
      </div>
      <h3 class="text-sm font-semibold leading-snug sm:text-base">{post.title}</h3>
      <p class="line-clamp-2 text-xs text-foreground/75 sm:text-sm">{post.excerpt}</p>
    </div>
  </a>
  <a
    href={`/categorie/${post.categorySlug}/`}
    class="sr-only"
  >
    Voir la categorie {post.category}
  </a>
</article>
