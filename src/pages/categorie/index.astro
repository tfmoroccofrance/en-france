---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EzoicAd from "@/components/EzoicAd.astro";
import { SITE } from "@/config";
import { fetchSeoCategories } from "@/lib/categories";

const categoriesResult = await fetchSeoCategories();
const categories = categoriesResult.data;
---

<Layout
  title={`Catégories | ${SITE.title}`}
  description="Parcourez toutes les catégories de recettes françaises : entrées, plats, desserts, et bien plus."
>
  <Header />
  <main id="main-content" class="app-layout py-10">

    <!-- ── Breadcrumb ── -->
    <nav aria-label="Fil d'Ariane" class="mb-6 text-sm text-foreground/50">
      <a href="/" class="hover:text-accent transition-colors">Accueil</a>
      <span class="mx-2 opacity-40">/</span>
      <span class="text-foreground/70">Catégories</span>
    </nav>

    <!-- ── Titre ── -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-foreground sm:text-4xl">
        Toutes les catégories
      </h1>
      <p class="mt-3 text-base text-foreground/60">
        Explorez nos recettes françaises par catégorie
      </p>
    </div>

    <!-- ══════════════════════════════════════
         Ezoic | 102 | under_page_title
    ══════════════════════════════════════ -->
    <div class="my-6">
      <EzoicAd id={102} />
    </div>

    <!-- ── Grille des catégories ── -->
    {categories.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map(category => (
          <a
            href={category.url}
            class="group flex items-center justify-between rounded-xl border border-border bg-background p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md"
          >
            <span class="text-base font-semibold text-foreground group-hover:text-accent transition-colors">
              {category.name}
            </span>
            <span class="text-accent opacity-0 group-hover:opacity-100 transition-opacity text-lg">→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-foreground/60">Aucune catégorie disponible pour le moment.</p>
    )}

    <!-- ══════════════════════════════════════
         Ezoic | 103 | bottom_of_page
    ══════════════════════════════════════ -->
    <div class="my-8">
      <EzoicAd id={103} />
    </div>

  </main>
  <Footer />
</Layout>