---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import DatabaseRecipeCard from "@/components/DatabaseRecipeCard.astro";
import EzoicAd from "@/components/EzoicAd.astro";
import { SITE } from "@/config";
import { fetchSeoCategories } from "@/lib/categories";
import { fetchPostsByCategory } from "@/lib/posts";

const categoriesResult = await fetchSeoCategories();
const categories = categoriesResult.data;

const categoriesWithPosts = await Promise.all(
  categories.map(async category => {
    const { data: posts } = await fetchPostsByCategory(category.slug);
    return {
      ...category,
      posts: posts.slice(0, 4),
      count: posts.length,
    };
  })
);

const canonicalURL = new URL("/categorie/", Astro.url).href;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: new URL("/", Astro.url).href },
    { "@type": "ListItem", position: 2, name: "Catégories", item: canonicalURL },
  ],
};
---

<Layout
  title={`Toutes les catégories de recettes françaises | ${SITE.title}`}
  description="Découvrez toutes nos catégories de recettes françaises : recettes faciles, repas rapides, recettes économiques et cuisine française traditionnelle."
  canonicalURL={canonicalURL}
  structuredData={breadcrumbSchema}
>
  <Header />
  <main id="main-content" class="pb-16">

    <!-- Hero -->
    <section class="bg-[linear-gradient(135deg,#fff7ef,#f7d9c4_55%,#f1b58f)] py-10 sm:py-14">
      <div class="app-layout text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-accent sm:text-sm">
          Recettes françaises
        </p>
        <h1 class="text-3xl font-bold text-[#432818] sm:text-5xl">
          Toutes les catégories
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-[#5f4636] sm:text-lg">
          Explorez notre collection de recettes françaises organisées par catégorie.
          Des recettes simples et savoureuses pour cuisiner au quotidien.
        </p>
      </div>
    </section>

    <!-- Ezoic | 102 | under_page_title -->
    <div class="app-layout my-6">
      <EzoicAd id={102} />
    </div>

    <!-- Catégories avec aperçu -->
    <div class="app-layout pt-6 space-y-10">
      {categoriesWithPosts.map(category => (
        <section class="rounded-2xl border border-border bg-background overflow-hidden shadow-sm">

          <!-- Category Header -->
          <div class="flex items-center justify-between gap-4 border-b border-border bg-muted/20 px-5 py-4">
            <div class="flex items-center gap-3">
              <span class="inline-block h-5 w-1 rounded-full bg-accent"></span>
              <div>
                <h2 class="text-base font-bold text-foreground sm:text-lg">
                  {category.name}
                </h2>
                <p class="text-xs text-foreground/50 mt-0.5">{category.count} recettes</p>
              </div>
            </div>
            <a
              href={category.url}
              class="shrink-0 rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent transition hover:bg-accent hover:text-white"
            >
              Voir tout →
            </a>
          </div>

          <!-- Posts as horizontal rows -->
          {category.posts.length > 0 ? (
            <ul class="divide-y divide-border">
              {category.posts.map((post, index) => (
                <li>
                  <a
                    href={post.url}
                    class="flex items-center gap-4 px-5 py-3 transition hover:bg-muted/30 group"
                  >
                    {post.featuredImage && (
                      <img
                        src={post.featuredImage}
                        alt={post.title}
                        loading={index === 0 ? "eager" : "lazy"}
                        class="h-16 w-24 flex-none rounded-lg object-cover shadow-sm"
                      />
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="line-clamp-2 text-sm font-semibold text-foreground group-hover:text-accent transition-colors leading-snug">
                        {post.title}
                      </p>
                      {post.excerpt && (
                        <p class="mt-1 line-clamp-1 text-xs text-foreground/50">
                          {post.excerpt}
                        </p>
                      )}
                    </div>
                    <span class="flex-none text-accent/40 text-lg group-hover:text-accent transition-colors">›</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="px-5 py-6 text-center text-xs text-foreground/40">
              Les recettes de cette catégorie arrivent bientôt.
            </div>
          )}

        </section>
      ))}
    </div>

    <!-- Ezoic | 103 | bottom_of_page -->
    <div class="app-layout my-10">
      <EzoicAd id={103} />
    </div>

    <!-- Texte SEO -->
    <section class="app-layout mt-6 mb-10 max-w-3xl mx-auto">
      <div class="rounded-2xl border border-border bg-muted/20 p-6 sm:p-8">
        <h2 class="mb-4 text-xl font-bold text-foreground">
          La cuisine française en catégories
        </h2>
        <div class="space-y-3 text-sm leading-relaxed text-foreground/70">
          <p>
            Bienvenue sur <strong>En France</strong>, votre guide de cuisine française accessible à tous.
            Que vous cherchiez des <strong>recettes faciles</strong> pour les soirs de semaine,
            des <strong>repas rapides</strong> à préparer en moins de 30 minutes,
            ou des idées de <strong>cuisine économique</strong> sans sacrifier le goût,
            vous trouverez votre bonheur ici.
          </p>
          <p>
            Chaque catégorie regroupe des recettes testées et approuvées,
            inspirées de la tradition culinaire française et adaptées
            à la vie moderne. Des entrées aux desserts, en passant par
            les plats du quotidien, découvrez le meilleur de la gastronomie française.
          </p>
          <p>
            Nos recettes sont accompagnées d'instructions claires,
            de listes d'ingrédients précises et de conseils pratiques
            pour réussir chaque plat du premier coup.
          </p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>