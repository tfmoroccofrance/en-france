---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const canonicalURL = new URL("/politique-de-confidentialite/", Astro.site).href;

const sections = [
  {
    num: 1,
    title: "Responsable du traitement",
    content: `Ce site est édité par <strong>Recettes françaises En France</strong>, accessible à l'adresse <a href="https://www.tfmorocco.com" class="text-accent hover:underline">www.tfmorocco.com</a>. Pour toute question relative à vos données personnelles, vous pouvez nous contacter à : <a href="mailto:contact@tfmorocco.com" class="text-accent hover:underline">contact@tfmorocco.com</a>.`
  },
  {
    num: 2,
    title: "Données collectées",
    items: [
      "<strong>Données de navigation :</strong> adresse IP, type de navigateur, pages visitées, durée des sessions, source du trafic.",
      "<strong>Données de formulaire :</strong> nom, adresse e-mail et message lorsque vous utilisez notre formulaire de contact.",
      "<strong>Cookies et technologies similaires :</strong> cookies de performance, cookies publicitaires (Google AdSense), cookies analytiques (Google Analytics)."
    ],
    note: "Nous ne collectons <strong>aucune donnée sensible</strong> (santé, opinions politiques, données bancaires, etc.)."
  },
  {
    num: 3,
    title: "Finalités du traitement",
    items: [
      "Améliorer l'expérience utilisateur et optimiser le contenu du site.",
      "Analyser les statistiques de fréquentation via <strong>Google Analytics</strong>.",
      "Afficher des publicités personnalisées ou non via <strong>Google AdSense</strong>.",
      "Répondre aux demandes envoyées via le formulaire de contact.",
      "Respecter nos obligations légales."
    ]
  },
  {
    num: 4,
    title: "Cookies",
    items: [
      "<strong>Cookies techniques :</strong> indispensables au fonctionnement du site, ils ne peuvent pas être désactivés.",
      "<strong>Cookies analytiques (Google Analytics) :</strong> ils nous permettent de mesurer l'audience. Ces données sont anonymisées.",
      "<strong>Cookies publicitaires (Google AdSense) :</strong> ils permettent à Google de diffuser des annonces adaptées à vos centres d'intérêt."
    ],
    note: `Vous pouvez modifier vos préférences via les paramètres de votre navigateur ou via <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Paramètres des annonces Google</a>.`
  },
  {
    num: 5,
    title: "Google AdSense et publicités",
    content: `Ce site est monétisé via <strong>Google AdSense</strong>. Google AdSense utilise des cookies pour diffuser des annonces pertinentes. Les utilisateurs peuvent désactiver la personnalisation des annonces en accédant aux <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">paramètres des annonces</a>. Notre site respecte les <a href="https://support.google.com/adsense/answer/48182" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">politiques de programme Google AdSense</a>.`
  },
  {
    num: 6,
    title: "Google Analytics",
    content: `Nous utilisons <strong>Google Analytics</strong> pour analyser le trafic. Cet outil collecte des informations anonymisées sur la manière dont les visiteurs utilisent le site. Vous pouvez empêcher la collecte via le <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">module complémentaire de désactivation</a> proposé par Google.`
  },
  {
    num: 7,
    title: "Partage des données avec des tiers",
    items: [
      "<strong>Google LLC</strong> (Google Analytics, Google AdSense) – dans le cadre des services décrits ci-dessus.",
      "Les autorités compétentes, uniquement si la loi nous y oblige."
    ],
    note: `Google traite vos données conformément à sa propre <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">politique de confidentialité</a>.`
  },
  {
    num: 8,
    title: "Durée de conservation",
    items: [
      "Données de contact (formulaire) : <strong>12 mois</strong> maximum.",
      "Données analytiques (Google Analytics) : 26 mois par défaut.",
      "Cookies : généralement jusqu'à <strong>13 mois</strong> pour les cookies tiers."
    ]
  },
  {
    num: 9,
    title: "Sécurité des données",
    content: "Nous mettons en œuvre des mesures techniques et organisationnelles appropriées pour protéger vos données. Notre site utilise le protocole <strong>HTTPS</strong> pour sécuriser toutes les communications."
  },
  {
    num: 10,
    title: "Vos droits (RGPD)",
    items: [
      "<strong>Droit d'accès :</strong> obtenir une copie des données que nous détenons sur vous.",
      "<strong>Droit de rectification :</strong> faire corriger des données inexactes.",
      "<strong>Droit à l'effacement :</strong> demander la suppression de vos données.",
      "<strong>Droit à la limitation :</strong> suspendre temporairement le traitement.",
      "<strong>Droit d'opposition :</strong> vous opposer au traitement publicitaire.",
      "<strong>Droit à la portabilité :</strong> recevoir vos données dans un format lisible."
    ],
    note: "Pour exercer l'un de ces droits, contactez-nous à l'adresse indiquée dans la section Contact."
  },
  {
    num: 11,
    title: "Liens vers des sites tiers",
    content: "Notre site peut contenir des liens vers des sites web tiers. Nous n'avons aucun contrôle sur leurs pratiques de confidentialité et déclinons toute responsabilité à leur égard."
  },
  {
    num: 12,
    title: "Modifications de la politique",
    content: "Nous nous réservons le droit de mettre à jour cette politique à tout moment. La date de la dernière mise à jour est indiquée en haut de cette page. Votre utilisation continue du site vaut acceptation des modifications."
  }
];
---

<Layout
  title="Politique de confidentialité | En France"
  description="Politique de confidentialité du site Recettes françaises En France. Découvrez comment nous collectons, utilisons et protégeons vos données personnelles."
  canonicalURL={canonicalURL}
>
  <Header />

  <main id="main-content">

    <!-- Hero -->
    <section class="bg-[linear-gradient(135deg,#fff7ef,#f7d9c4_55%,#f1b58f)] py-12 sm:py-16">
      <div class="app-layout text-center">
        <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent">
          🔒 Données & Confidentialité
        </span>
        <h1 class="mt-4 text-2xl font-bold text-[#432818] sm:text-3xl lg:text-4xl">
          Politique de <span class="text-accent italic">confidentialité</span>
        </h1>
        <p class="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-[#6b4c3b]">
          Dernière mise à jour : janvier 2026 — Conformément au RGPD (UE 2016/679)
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="app-layout py-10">
      <div class="mx-auto max-w-2xl">
        <div class="rounded-2xl border border-border bg-muted/30 px-8 py-8 shadow-sm">
          <p class="text-sm leading-relaxed text-foreground/80">
            La protection de vos données personnelles est une priorité pour <strong class="text-foreground">Recettes françaises En France</strong>. Cette politique de confidentialité vous informe de manière transparente sur la collecte, l'utilisation et la protection de vos données lorsque vous utilisez notre site <a href="https://www.tfmorocco.com" class="text-accent hover:underline">www.tfmorocco.com</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Sections -->
    <div class="app-layout pb-16">
      <div class="mx-auto max-w-2xl space-y-8">
        {sections.map(section => (
          <div class="rounded-xl border border-border bg-background p-6 shadow-sm">
            <div class="mb-4 flex items-center gap-3">
              <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-accent text-xs font-bold text-white">
                {section.num}
              </span>
              <h2 class="text-base font-bold text-foreground sm:text-lg">{section.title}</h2>
            </div>

            {section.content && (
              <p class="text-sm leading-relaxed text-foreground/75" set:html={section.content} />
            )}

            {section.items && (
              <ul class="mt-2 space-y-2">
                {section.items.map(item => (
                  <li class="flex items-start gap-2 text-sm text-foreground/75">
                    <span class="mt-1 flex-none text-accent">›</span>
                    <span set:html={item} />
                  </li>
                ))}
              </ul>
            )}

            {section.note && (
              <p class="mt-4 rounded-lg bg-muted/40 px-4 py-3 text-xs leading-relaxed text-foreground/65" set:html={section.note} />
            )}
          </div>
        ))}

        <!-- Contact -->
        <div class="rounded-xl border border-accent/20 bg-accent/5 p-6 shadow-sm">
          <div class="mb-4 flex items-center gap-3">
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-accent text-xs font-bold text-white">13</span>
            <h2 class="text-base font-bold text-foreground sm:text-lg">Contact</h2>
          </div>
          <p class="text-sm leading-relaxed text-foreground/75 mb-4">
            Pour toute question relative à cette politique ou pour exercer vos droits, contactez-nous :
          </p>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            {[
              { label: "Site web", value: "www.tfmorocco.com", href: "https://www.tfmorocco.com" },
              { label: "Email principal", value: "contact@tfmorocco.com", href: "mailto:contact@tfmorocco.com" },
              { label: "Email secondaire", value: "ftm.contact.1@gmail.com", href: "mailto:ftm.contact.1@gmail.com" },
            ].map(item => (
              <div class="rounded-lg border border-border bg-background p-4 text-center">
                <p class="text-xs font-semibold uppercase tracking-wide text-foreground/50">{item.label}</p>
                <a
                  href={item.href}
                  class="mt-1 block text-xs font-semibold text-accent hover:underline"
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
                >
                  {item.value}
                </a>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs text-foreground/50 text-center">
            Nous répondons à toute demande dans un délai maximum de <strong>30 jours</strong> ouvrables.
          </p>
        </div>

      </div>
    </div>

  </main>

  <Footer />
</Layout>
