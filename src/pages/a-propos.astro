---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const canonicalURL = new URL("/a-propos/", Astro.site).href;
---

<Layout
  title="À propos — Recettes Françaises | En France"
  description="Découvrez l'histoire de En France, un espace dédié aux recettes françaises authentiques, rapides et économiques pour cuisiner au quotidien en France."
  canonicalURL={canonicalURL}
>
  <Header />

  <main id="main-content">

    <!-- Hero -->
    <section class="relative overflow-hidden bg-[linear-gradient(135deg,#fff7ef,#f7d9c4_55%,#f1b58f)] py-16 sm:py-24">
      <div class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="app-layout text-center">
        <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-accent">
          🇫🇷 Notre histoire
        </span>
        <h1 class="mt-4 text-3xl font-bold text-[#432818] sm:text-4xl lg:text-5xl">
          La cuisine française,<br/>
          <span class="text-accent italic">avec passion</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-[#6b4c3b] sm:text-base">
          Des recettes authentiques, simples et économiques — partagées avec sincérité pour tous les amateurs de cuisine française.
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="app-layout py-14">
      <div class="mx-auto max-w-2xl">
        <div class="rounded-2xl border border-border bg-muted/30 px-8 py-10 text-center shadow-sm">
          <p class="text-base leading-relaxed text-foreground/80 sm:text-lg">
            Bienvenue sur <strong class="text-foreground">Recettes françaises En France</strong> — un espace né d'une passion sincère pour la gastronomie française et du désir profond de la rendre accessible à tous, sans compromis sur l'authenticité ni sur le goût.
          </p>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="app-layout">
      <div class="border-t border-border"></div>
    </div>

    <!-- Fondatrice -->
    <section class="app-layout py-14">
      <div class="mx-auto grid max-w-3xl grid-cols-1 items-center gap-10 sm:grid-cols-2">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-accent">La fondatrice</span>
          <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl">
            Céline <span class="text-accent italic">Anderson</span>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-foreground/75">
            Passionnée de cuisine française depuis toujours, j'ai créé cet espace pour partager avec vous ce que j'aime le plus : des recettes vraies, testées, et accessibles à tous les budgets et tous les niveaux.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-foreground/75">
            Sur <strong>En France</strong>, je publie régulièrement tout ce qu'il y a de nouveau et de fiable dans l'univers de la cuisine française — des plats du terroir aux classiques revisités, toujours avec le plaisir sincère de partager.
          </p>
          <div class="mt-5 inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-1.5 text-xs font-semibold text-accent">
            Fondatrice & Rédactrice
          </div>
        </div>
        <div class="overflow-hidden rounded-2xl border border-border shadow-md">
          <img
            src="https://xkrbovjgikucfsjmtkua.supabase.co/storage/v1/object/public/En%20France/en%20france.jfif"
            alt="Céline Anderson – Fondatrice de En France"
            class="h-72 w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="app-layout">
      <div class="border-t border-border"></div>
    </div>

    <!-- Mission -->
    <section class="app-layout py-14">
      <div class="mx-auto max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent">Ce que nous offrons</span>
        <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl">
          Notre <span class="text-accent italic">mission</span>
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-foreground/75">
          Notre objectif est simple : vous proposer des recettes françaises rapides, économiques et savoureuses — sans jamais sacrifier l'authenticité.
        </p>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {[
            { icon: "🥘", title: "Recettes testées", desc: "Chaque recette est vérifiée avant publication pour vous garantir un résultat réussi." },
            { icon: "💶", title: "Petit budget", desc: "Des ingrédients simples, disponibles partout, pour cuisiner sans se ruiner." },
            { icon: "📋", title: "Étape par étape", desc: "Des instructions claires et détaillées, accessibles à tous les niveaux." },
            { icon: "🔄", title: "Contenu actualisé", desc: "Nous publions régulièrement de nouvelles recettes fiables et de saison." },
          ].map(item => (
            <div class="flex items-start gap-4 rounded-xl border border-border bg-background p-5 shadow-sm">
              <span class="text-2xl">{item.icon}</span>
              <div>
                <p class="text-sm font-semibold text-foreground">{item.title}</p>
                <p class="mt-1 text-xs leading-relaxed text-foreground/65">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Engagement -->
    <section class="bg-muted/30 py-14">
      <div class="app-layout">
        <div class="mx-auto max-w-3xl">
          <span class="text-xs font-semibold uppercase tracking-widest text-accent">Notre promesse</span>
          <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl">
            Un contenu honnête, <span class="text-accent italic">toujours</span>
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-foreground/75">
            Toutes les informations publiées sur ce site sont rédigées avec sérieux et vérifiées avec soin. Nous ne publions jamais de contenu trompeur, de recettes non testées, ni de conseils alimentaires non fiables.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-foreground/75">
            Ce site respecte pleinement les politiques de <strong>Google AdSense</strong> — toute publicité est clairement identifiée afin de garantir une expérience de navigation transparente et agréable.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {["✓ Contenu vérifié", "✓ Google AdSense conforme", "✓ SEO optimisé", "✓ E-E-A-T Google"].map(badge => (
              <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                {badge}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="app-layout py-14">
      <div class="mx-auto max-w-3xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent">Restons en contact</span>
        <h2 class="mt-3 text-2xl font-bold text-foreground sm:text-3xl">
          Nous <span class="text-accent italic">écrire</span>
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-foreground/75">
          Une question, une idée de recette, une collaboration ? Nous lisons chaque message et répondons sous <strong>48 à 72 heures ouvrables</strong>.
        </p>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
          {[
            { icon: "📬", label: "Email général", value: "ftm.contact.1@gmail.com", href: "mailto:ftm.contact.1@gmail.com" },
            { icon: "✉️", label: "Email professionnel", value: "contact@tfmorocco.com", href: "mailto:contact@tfmorocco.com" },
            { icon: "🌐", label: "Site web", value: "www.tfmorocco.com", href: "https://www.tfmorocco.com" },
          ].map(item => (
            <div class="rounded-xl border border-border bg-background p-5 text-center shadow-sm">
              <span class="text-2xl">{item.icon}</span>
              <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-foreground/50">{item.label}</p>
              <a
                href={item.href}
                class="mt-1 block text-sm font-semibold text-accent hover:underline"
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                {item.value}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="bg-[linear-gradient(135deg,#fff7ef,#f7d9c4)] py-16 text-center">
      <div class="app-layout">
        <p class="text-3xl">♡</p>
        <h2 class="mt-4 text-2xl font-bold text-[#432818] sm:text-3xl">
          Merci de votre <span class="text-accent italic">confiance</span>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-[#6b4c3b]">
          Votre présence et votre fidélité sont notre plus belle récompense. Bonne cuisine, bon appétit — et à très vite !
        </p>
        <a
          href="/"
          class="mt-8 inline-block rounded-xl bg-accent px-8 py-3 text-sm font-semibold text-white shadow-md transition hover:opacity-90"
        >
          Découvrir nos recettes →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
