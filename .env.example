# Copy to .env.local (Astro dev/build) or .env (scripts/*.mjs) and fill in the values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Supabase, public (browser) — Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase, server-only — Supabase → Project Settings → API (service role key is secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, only for scripts/migrate-images-to-r2.mjs — Cloudflare → R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# Google Search Console verification (optional, public)
PUBLIC_GOOGLE_SITE_VERIFICATION=
